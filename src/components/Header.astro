---
/**
 * Header — barre supérieure :
 *   1) Bandeau info fixe (ex-marquee) — OpeningBadge + USPs statiques (ADR-007)
 *   2) Row "Mon véhicule" — chip Oscaro-style (ADR-008)
 *   3) Barre principale (sticky, logo + nav + CTAs tel/WA/devis)
 *
 * Cf. plan.md §3.2 (header) ; ADR-007 (remove marquee → static strip) ;
 *     ADR-008 (vehicle loop) ; proposal #7 (opening badge live).
 *
 * Mobile :
 *   - Row 1 : seule l'OpeningBadge reste (USPs cachés).
 *   - Row 2 : chip véhicule toujours visible.
 *   - La barre principale collapse les liens dans un menu burger.
 */

import Logo from './Logo.astro';
import WhatsAppIcon from './WhatsAppIcon.astro';
import VehiclePanel from './VehiclePanel.tsx';
import OpeningBadge from './OpeningBadge.astro';
import { STORE, telUrl, whatsappUrl } from '../data/store.js';
import { MAIN_NAV } from '../data/menu.js';

const currentPath = Astro.url.pathname;
const isActive = (href: string) => currentPath === href || (href !== '/' && currentPath.startsWith(href));

// 4 USPs statiques (remplace le marquee — ADR-007 "épurée, pas de scroll gratuit").
// Chaque item = icon svg + label court. Desktop-only, masqué < lg pour ne pas
// concurrencer l'OpeningBadge sur mobile où l'espace est précieux.
const usps = [
  {
    label: 'Mondial Relay',
    svg: '<path d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2"/><path d="M15 18H9"/><path d="M19 18h2a1 1 0 0 0 1-1v-3.65a1 1 0 0 0-.22-.624l-3.48-4.35A1 1 0 0 0 17.52 8H14"/><circle cx="17" cy="18" r="2"/><circle cx="7" cy="18" r="2"/>',
  },
  {
    label: 'Retrait magasin',
    svg: '<path d="m7.5 4.27 9 5.15"/><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/><path d="m3.3 7 8.7 5 8.7-5"/><path d="M12 22V12"/>',
  },
  {
    label: 'Devis sous 24 h',
    svg: '<circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>',
  },
  {
    label: 'Conseil humain',
    svg: '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>',
  },
];

const waUrl = whatsappUrl();
---

<header class="w-full">
  {/* === 1) Bandeau info fixe — OpeningBadge + USPs statiques ============
       Remplace l'ancien marquee (ADR-007 : "l'infinite-scroll USP est une
       béquille esthétique, on s'en passe"). La pill "Ouvert maintenant"
       donne un signal de vie plus fort qu'un défilement décoratif. */}
  <div
    class="bg-marine-900 text-offwhite-50 border-b border-marine-700"
    role="region"
    aria-label="Statut et avantages Pièces Auto Colomiers"
  >
    <div class="container-tight py-2 flex items-center justify-between gap-3">
      {/* Left : live opening badge (always visible, even mobile) */}
      <OpeningBadge variant="light" />

      {/* Right : static USPs — desktop only, tight spacing, separators subtils */}
      <ul class="hidden lg:flex items-center gap-5 text-xs text-offwhite-200" aria-label="Avantages">
        {usps.map((usp, idx) => (
          <li class="inline-flex items-center gap-1.5">
            {idx > 0 && <span class="w-px h-3 bg-white/10 mr-3" aria-hidden="true"></span>}
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="text-sky-300 shrink-0" set:html={usp.svg}></svg>
            <span class="font-medium whitespace-nowrap">{usp.label}</span>
          </li>
        ))}
      </ul>

      {/* Right-mobile : one-line compact call-out (replaces USPs < lg) */}
      <a
        href={telUrl()}
        class="lg:hidden inline-flex items-center gap-1.5 text-xs font-semibold text-sky-300 hover:text-sky-200 whitespace-nowrap"
        aria-label={`Appeler — ${STORE.contact.telDisplay}`}
      >
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        {STORE.contact.telDisplay}
      </a>
    </div>
  </div>

  {/* === 1.5) Mon véhicule (chip Oscaro-style — ADR-008, Phase 5) ==========
       IMPORTANT : ne PAS ajouter `backdrop-blur-*` / `transform` / `filter` sur
       ce wrapper — cela crée un containing block pour les descendants
       `position: fixed`, ce qui piégerait le modal <VehiclePanel /> dans
       la bande (bug 2026-05-04). Le modal est de toute façon portal'd vers
       document.body, mais on garde le wrapper "propre" par défense. */}
  <div class="bg-marine-700/60 border-b border-white/10">
    <div class="container-tight py-2 flex items-center justify-between gap-3">
      <span class="hidden md:inline-flex eyebrow-light shrink-0 text-white/70">Pour un devis personnalisé</span>
      <VehiclePanel client:load />
    </div>
  </div>

  {/* === 2) Barre principale (sticky) ====================================== */}
  <div class="bg-marine-800 text-white sticky top-0 z-40 shadow-lg shadow-marine-900/20">
    <div class="container-tight flex items-center justify-between gap-4 py-3 lg:py-4">
      {/* Logo */}
      <Logo size="md" variant="light" withText={true} href="/" class="shrink-0" />

      {/* Nav desktop */}
      <nav class="hidden lg:flex items-center gap-1" aria-label="Navigation principale">
        {MAIN_NAV.map((item) => (
          <a
            href={item.href}
            class={`px-4 py-2 rounded-lg font-display uppercase tracking-wide text-sm transition-colors duration-200 ${
              isActive(item.href)
                ? 'bg-white text-marine-900 shadow-card'
                : 'text-white hover:bg-white/10'
            }`}
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))}
      </nav>

      {/* CTAs desktop */}
      <div class="hidden md:flex items-center gap-2 lg:gap-3 shrink-0">
        {/* Tel */}
        <a
          href={telUrl()}
          class="hidden lg:inline-flex items-center gap-2 px-3 py-2 rounded-lg text-white hover:bg-white/10 transition-colors text-sm font-semibold"
          aria-label={`Téléphone — ${STORE.contact.telDisplay}`}
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
          </svg>
          {STORE.contact.telDisplay}
        </a>

        {/* WhatsApp — vert de marque + glyphe authentique (ADR-006, F5) */}
        <a
          href={waUrl}
          target="_blank"
          rel="noopener"
          class="inline-flex items-center gap-2 px-3 py-2 rounded-lg bg-brand-whatsapp text-white hover:bg-brand-whatsapp-dark transition-colors text-sm font-semibold"
          aria-label="Contacter via WhatsApp"
        >
          <WhatsAppIcon size={18} />
          <span class="hidden lg:inline">WhatsApp</span>
        </a>

        {/* Devis primary (ADR-001 — white pill sur fond marine, plus de jaune CTA) */}
        <a
          href="/contact#devis"
          class="btn btn-sm md:btn-md bg-white text-marine-900 shadow-card hover:bg-offwhite-100 hover:-translate-y-0.5 hover:shadow-card-hover"
        >
          Devis 24 h
        </a>
      </div>

      {/* Burger mobile */}
      <button
        id="menu-toggle"
        type="button"
        class="lg:hidden inline-flex items-center justify-center size-10 rounded-lg hover:bg-white/10 transition-colors"
        aria-label="Ouvrir le menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg id="menu-icon-open" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="4" x2="20" y1="6" y2="6"/>
          <line x1="4" x2="20" y1="12" y2="12"/>
          <line x1="4" x2="20" y1="18" y2="18"/>
        </svg>
        <svg id="menu-icon-close" class="hidden" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M18 6 6 18"/>
          <path d="m6 6 12 12"/>
        </svg>
      </button>
    </div>

    {/* Menu mobile (overlay slide-in) */}
    <div
      id="mobile-menu"
      class="lg:hidden fixed inset-x-0 top-0 bottom-0 z-50 translate-x-full transition-transform duration-300 ease-brand bg-marine-900 text-white pt-20 px-6 pb-8 overflow-y-auto"
      aria-hidden="true"
    >
      <button
        id="menu-close-x"
        type="button"
        class="absolute top-4 right-4 inline-flex items-center justify-center size-10 rounded-lg hover:bg-white/10 transition-colors"
        aria-label="Fermer le menu"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M18 6 6 18"/>
          <path d="m6 6 12 12"/>
        </svg>
      </button>

      <Logo size="md" variant="light" withText={true} href="/" class="mb-8" />

      <nav class="flex flex-col gap-2 mb-8" aria-label="Navigation mobile">
        {MAIN_NAV.map((item) => (
          <a
            href={item.href}
            class={`block px-4 py-3 rounded-lg font-display uppercase tracking-wide text-lg transition-colors ${
              isActive(item.href)
                ? 'bg-white text-marine-900'
                : 'hover:bg-white/10'
            }`}
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            {item.label}
            <span class="block text-xs font-normal text-white/60 mt-0.5 normal-case tracking-normal">{item.desc}</span>
          </a>
        ))}
      </nav>

      <div class="flex flex-col gap-3 pt-6 border-t border-white/10">
        <a href="/contact#devis" class="btn btn-lg bg-white text-marine-900 w-full">Devis 24 h</a>
        <a href={waUrl} target="_blank" rel="noopener" class="btn-whatsapp btn-lg w-full">
          <WhatsAppIcon size={20} />
          WhatsApp Business
        </a>
        <a href={telUrl()} class="btn btn-lg bg-white/10 text-white w-full">
          {STORE.contact.telDisplay}
        </a>
      </div>
    </div>
  </div>
</header>

<script is:inline>
  // Toggle menu mobile — vanilla JS (pas de React island pour ce besoin simple)
  (function () {
    const btn = document.getElementById('menu-toggle');
    const closeX = document.getElementById('menu-close-x');
    const menu = document.getElementById('mobile-menu');
    const iconOpen = document.getElementById('menu-icon-open');
    const iconClose = document.getElementById('menu-icon-close');
    if (!btn || !menu) return;

    const setOpen = (open) => {
      menu.classList.toggle('translate-x-full', !open);
      menu.classList.toggle('translate-x-0', open);
      menu.setAttribute('aria-hidden', String(!open));
      btn.setAttribute('aria-expanded', String(open));
      btn.setAttribute('aria-label', open ? 'Fermer le menu' : 'Ouvrir le menu');
      if (iconOpen) iconOpen.classList.toggle('hidden', open);
      if (iconClose) iconClose.classList.toggle('hidden', !open);
      document.body.classList.toggle('scroll-locked', open);
    };

    btn.addEventListener('click', () => {
      const isOpen = menu.classList.contains('translate-x-0');
      setOpen(!isOpen);
    });
    closeX?.addEventListener('click', () => setOpen(false));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && menu.classList.contains('translate-x-0')) setOpen(false);
    });
    // Close when clicking a nav link inside mobile menu
    menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  })();
</script>
