---
/**
 * Home — page d'accueil V1.
 *
 * Sections (J1, version courte) :
 *   1) Hero
 *   2) Trust strip USPs
 *   3) Catégories phares (12)
 *   4) Services (4)
 *   5) FAQ (top 5)
 *   6) CTA final
 *
 * Sections additionnelles V2 (J2) :
 *   - "Notre proximité" intro
 *   - Témoignages slider
 *   - Why choose us (3 raisons)
 *   - Marques fournisseurs grid
 *
 * Cf. plan.md §4 (architecture home).
 */

import Layout from '../layouts/Layout.astro';
import TikTokGrid from '../components/TikTokGrid';
import WhatsAppIcon from '../components/WhatsAppIcon.astro';
import { publicAssetExists } from '../lib/public-asset';
import { STORE, whatsappUrl, telUrl } from '../data/store.js';
import { CATEGORIES, getCategoriesByFamily } from '../data/categories.js';
import { SERVICES } from '../data/services.js';
import { FAQ } from '../data/faq.js';
import { BRANDS } from '../data/brands.js';
import { TIKTOKS, TIKTOK_PROFILE_URL } from '../data/tiktoks.js';
import AvisWidget from '../components/AvisWidget.astro';
import { MARQUES_SHORTCUTS } from '../data/vehicle-marques-shortcut.js';
import { getTopTestimonials, hasTestimonials } from '../data/testimonials.js';

// Phase 2 D-2026-05-13d (override ADR-002) — vrais avis Google copiés sur le
// site quand l'owner en a collé. Vide tant que l'owner n'a pas paté — dans
// ce cas la section se replie sur l'AvisWidget seul (badge agrégé).
const topTestimonials = getTopTestimonials(3);
const showTestimonials = hasTestimonials();

/**
 * Home catalog index — 7 families surfaced (ADR-012, D-2026-05-13b).
 * The 16-family roster lives in `categories.js` ; on the home we feature
 * the 7 with highest customer-search intent (entretien courant + pannes
 * fréquentes). The remaining 9 are accessible via `/catalogue`.
 *
 * Order matters : reflects "ce qu'on cherche en premier quand sa voiture
 * a un souci" — freinage en tête (sécurité), puis moteur, puis usure
 * cyclique (distribution, démarrage), puis confort & saison (éclairage,
 * suspension, échappement).
 */
const homeFamilies = [
  { id: 'freinage',     label: 'Freinage',           tagline: 'Plaquettes, disques, étriers — la sécurité en priorité.' },
  { id: 'moteur',       label: 'Moteur',             tagline: 'Filtration, allumage, injection — l\'entretien courant.' },
  { id: 'distribution', label: 'Distribution',       tagline: 'Kits complets courroie + galets + tendeur.' },
  { id: 'demarrage',    label: 'Démarrage & charge', tagline: 'Batterie, alternateur, démarreur — l\'hiver d\'abord.' },
  { id: 'eclairage',    label: 'Éclairage',          tagline: 'Phares, ampoules, feux — visibilité et CT.' },
  { id: 'suspension',   label: 'Suspension',         tagline: 'Amortisseurs, rotules, roulements — tenue de route.' },
  { id: 'echappement',  label: 'Échappement',        tagline: 'Pots, catalyseurs, FAP — bruit et émissions.' },
] as const;

const homeServices = SERVICES.slice(0, 4);
const homeFaq = FAQ.filter((f) => f.home).slice(0, 5);

// "Comment ça marche" — 3-step Oscaro-style (D-2026-05-13d, Phase 5.1).
// Remplace l'ancien bloc "Why choose us" (subsumed dans le hero + trust strip).
const howSteps = [
  {
    n: 1,
    title: 'Décrivez la pièce',
    desc: 'Marque, modèle, année, et la pièce recherchée. Par formulaire, WhatsApp ou téléphone.',
    cta: { label: 'Demander un devis', href: '/contact#devis' },
  },
  {
    n: 2,
    title: 'Devis sous 24 h',
    desc: 'Notre équipe vérifie la compatibilité multi-marques et revient avec un prix ferme.',
    cta: null,
  },
  {
    n: 3,
    title: 'Retrait ou Mondial Relay',
    desc: 'Retrait gratuit au magasin de Colomiers ou expédition en point Mondial Relay partout en France.',
    cta: { label: 'Notre magasin', href: '/notre-magasin' },
  },
];

// TikToks — filtre build-time : ne garder que les entrées dont le MP4 existe
// sur disque. Évite les <video> 404 si le client n'a pas encore lancé
// `npm run assets:tiktok` (qui dépend de yt-dlp + ffmpeg installés).
// Normalise le shape pour le composant React (viewCount camelCase).
const availableTiktoks = TIKTOKS
  .filter((t: typeof TIKTOKS[number]) => publicAssetExists(t.mp4))
  .map((t: typeof TIKTOKS[number]) => ({
    id: t.id,
    url: t.url,
    mp4: t.mp4,
    poster: publicAssetExists(t.poster) ? t.poster : '', // poster optionnel
    title: t.title,
    viewCount: (t as { views?: number; viewCount?: number }).views ?? (t as { viewCount?: number }).viewCount ?? 0,
    duration: (t as { durationSec?: number; duration?: number }).durationSec ?? (t as { duration?: number }).duration ?? 0,
    width: t.width,
    height: t.height,
  }));
const showTiktoks = availableTiktoks.length > 0;
---

<Layout
  title="Pièces Auto Colomiers — Pièces auto neuves multi-marques à Colomiers"
  description="Vendeur de pièces auto neuves multi-marques à Colomiers. Devis sous 24 h, retrait magasin, expédition Mondial Relay. Tourisme, 4×4, japonaises, utilitaires."
  faq={homeFaq.map((f) => ({ q: f.q, a: f.a }))}
>
  {/* === 1) Hero — vehicle-first (Phase 5.1, D-2026-05-13d) ================
       L'ancien hero (gradient marine + photo storefront + écusson "Toulouse
       Ouest") a été retiré au profit de la framing Oscaro "véhicule
       d'abord". La photo magasin et l'écusson reviennent sur /notre-magasin
       (Phase 5.1 DoD). Le bouton CTA "Choisir mon véhicule" dispatch le
       custom-event `pac:vehicle-open` qu'écoute <VehiclePanel /> monté dans
       le Header — ouvre la modal cascade/manuelle/plaque. */}
  <section class="bg-offwhite border-b border-charcoal-100">
    <div class="container-tight pt-10 pb-14 md:pt-16 md:pb-20 grid lg:grid-cols-12 gap-8 lg:gap-12 items-center">
      <div class="lg:col-span-7 max-w-2xl">
        <span class="eyebrow" data-reveal>Spécialiste pièces auto · Colomiers</span>
        <h1
          class="title-accent font-display uppercase text-h1 lg:text-display-1 leading-[1.02] mt-3 mb-5"
          data-reveal
          data-reveal-delay="1"
          style="view-transition-name: hero-title;"
        >
          Trouvez votre pièce<br />
          <span class="text-marine-700">parmi {CATEGORIES.length} catégories.</span>
        </h1>
        <p class="text-lg text-charcoal-600 max-w-prose mb-7 leading-relaxed" data-reveal data-reveal-delay="2">
          Tourisme, 4×4, japonaises, utilitaires — multi-marques.
          Devis sous 24 heures, retrait magasin ou expédition Mondial Relay
          partout en France.
        </p>
        <div class="flex flex-wrap items-center gap-3" data-reveal data-reveal-delay="3">
          <a href="/contact#devis" class="btn-primary btn-lg">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
            Demander un devis
          </a>
          <a href={whatsappUrl()} target="_blank" rel="noopener" class="btn-whatsapp btn-lg">
            <WhatsAppIcon size={20} />
            WhatsApp Business
          </a>
        </div>
        <p class="text-sm text-charcoal-500 mt-5">
          ou appelez le{' '}
          <a href={telUrl()} class="link-inline">{STORE.contact.telDisplay}</a>
        </p>
      </div>

      {/* Véhicule CTA card — déclenche la VehiclePanel modal via event API. */}
      <aside class="lg:col-span-5" data-reveal data-reveal-delay="4" aria-labelledby="hero-vehicle-title">
        <div class="card p-6 md:p-7 border-2 border-sky-200 hover:border-sky-400 transition-colors">
          <div class="flex items-start gap-4 mb-5">
            <span class="inline-flex items-center justify-center size-12 rounded-pill bg-marine-800 text-white shrink-0" aria-hidden="true">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 17h2c.6 0 1-.4 1-1v-3c0-.9-.7-1.7-1.5-1.9C18.7 10.6 16 10 16 10s-1.3-1.4-2.2-2.3c-.5-.4-1.1-.7-1.8-.7H5c-.6 0-1.1.4-1.4.9l-1.4 2.9A3.7 3.7 0 0 0 2 12v4c0 .6.4 1 1 1h2"/><circle cx="7" cy="17" r="2"/><path d="M9 17h6"/><circle cx="17" cy="17" r="2"/></svg>
            </span>
            <div>
              <h2 id="hero-vehicle-title" class="font-display uppercase text-base lg:text-lg text-charcoal-800 leading-tight">Pour quel véhicule ?</h2>
              <p class="text-sm text-charcoal-500 mt-1">Devis personnalisé, compatibilité garantie.</p>
            </div>
          </div>
          <button
            type="button"
            class="btn-primary btn-md w-full justify-center"
            data-vehicle-open
            aria-label="Renseigner mon véhicule — ouvre la fenêtre de sélection"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14"/><path d="M5 12h14"/></svg>
            Choisir mon véhicule
          </button>
          <p class="text-xs text-charcoal-400 mt-3 text-center">
            Cascade marque/modèle/année · saisie libre · plaque d'immatriculation
          </p>
        </div>
      </aside>
    </div>
  </section>

  {/* === 2) Trust strip ==================================================== */}
  <section class="bg-white border-y border-charcoal-100">
    <div class="container-tight py-6">
      <ul class="grid grid-cols-2 md:grid-cols-4 gap-y-4 gap-x-8 text-center md:text-left" data-reveal-group>
        <li class="flex items-center gap-3 justify-center md:justify-start" data-reveal>
          <span class="inline-flex size-10 shrink-0 items-center justify-center rounded-full bg-marine-800 text-white">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2"/><path d="M15 18H9"/><path d="M19 18h2a1 1 0 0 0 1-1v-3.65a1 1 0 0 0-.22-.624l-3.48-4.35A1 1 0 0 0 17.52 8H14"/><circle cx="17" cy="18" r="2"/><circle cx="7" cy="18" r="2"/></svg>
          </span>
          <div>
            <div class="font-display uppercase text-sm">Mondial Relay</div>
            <div class="text-xs text-charcoal-500">Partout en France</div>
          </div>
        </li>
        <li class="flex items-center gap-3 justify-center md:justify-start" data-reveal>
          <span class="inline-flex size-10 shrink-0 items-center justify-center rounded-full bg-sky-400 text-marine-900">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m7.5 4.27 9 5.15"/><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/><path d="m3.3 7 8.7 5 8.7-5"/><path d="M12 22V12"/></svg>
          </span>
          <div>
            <div class="font-display uppercase text-sm">Retrait magasin</div>
            <div class="text-xs text-charcoal-500">Gratuit, sur place</div>
          </div>
        </li>
        <li class="flex items-center gap-3 justify-center md:justify-start" data-reveal>
          <span class="inline-flex size-10 shrink-0 items-center justify-center rounded-full bg-marine-800 text-white">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          </span>
          <div>
            <div class="font-display uppercase text-sm">Devis sous 24 h</div>
            <div class="text-xs text-charcoal-500">Réponse rapide</div>
          </div>
        </li>
        <li class="flex items-center gap-3 justify-center md:justify-start" data-reveal>
          <span class="inline-flex size-10 shrink-0 items-center justify-center rounded-full bg-sky-400 text-marine-900">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19.5 12.572 12 20l-7.5-7.428A5 5 0 1 1 12 6.006a5 5 0 1 1 7.5 6.572"/></svg>
          </span>
          <div>
            <div class="font-display uppercase text-sm">Conseil pro</div>
            <div class="text-xs text-charcoal-500">Équipe humaine</div>
          </div>
        </li>
      </ul>
    </div>
  </section>

  {/* Phase 5.1 D-2026-05-13d : la section "Notre proximité" (intro narrative
       + stats grid) a été retirée d'ici. Elle revivra sur /notre-magasin
       quand cette page sera enrichie (Phase 5.1 DoD : "move both to
       notre-magasin.astro"). La home reste centrée sur le parcours pièce. */}

  {/* === 3) Index catalogue (groupé par famille) ===========================
       Refactor 2026-05-13b — la home n'est plus une "vitrine corporate"
       (12 cartes décoratives) mais un vrai entry-point catalogue Oscaro-
       shaped : 7 familles × ~4 catégories = ~28 entrées scannables, chaque
       famille avec son H2 propre (peer-level catalog entry-points, pas
       de H2 umbrella sur la section). L'utilisateur qui connaît son
       besoin clique au bon endroit en 1 scroll au lieu de devoir aller
       dans `/catalogue` puis chercher. Cf. ADR-012, handoff 2026-05-06
       §5.1 step 4, roadmap.md Phase 5.1 DoD. */}
  <section class="section-y bg-white border-t border-charcoal-100">
    <div class="container-tight">
      <div class="mb-12 max-w-2xl">
        <span class="eyebrow" data-reveal>Catalogue</span>
        <p class="text-charcoal-700 text-xl lg:text-2xl font-display mt-2 mb-3 leading-snug" data-reveal data-reveal-delay="1">
          Trouvez votre pièce.
        </p>
        <p class="text-charcoal-500 text-lg" data-reveal data-reveal-delay="2">
          {CATEGORIES.length} catégories réparties en 16 familles, multi-marques.
          De la plaquette de frein au turbo, du démarreur au pare-chocs.
        </p>
      </div>

      {homeFamilies.map((family) => {
        const familyCats = getCategoriesByFamily(family.id).slice(0, 4);
        if (familyCats.length === 0) return null;
        return (
          <div class="mt-14 first:mt-0" data-reveal>
            <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2 mb-2">
              <h2 id={`family-${family.id}`} class="font-display uppercase text-h3 lg:text-h2 text-marine-900 scroll-mt-24">
                {family.label}
              </h2>
              <a
                href={`/catalogue#family-${family.id}`}
                class="inline-flex items-center gap-1 text-sm font-semibold text-marine-700 hover:text-sky-600 whitespace-nowrap transition-colors"
              >
                Voir tout {family.label.toLowerCase()}
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
              </a>
            </div>
            <p class="text-charcoal-500 text-base mb-6">{family.tagline}</p>
            <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 lg:gap-5" data-reveal-group>
              {familyCats.map((cat) => (
                <a href={`/catalogue/${cat.slug}`} class="card-interactive group flex flex-col" data-reveal>
                  <div class="card-media aspect-[4/3] rounded-t-card bg-gradient-to-br from-marine-700 to-marine-900">
                    <span
                      class="absolute inset-0 flex items-center justify-center font-display font-bold text-6xl text-sky-400/30 select-none pointer-events-none"
                      aria-hidden="true"
                    >
                      {cat.label.charAt(0)}
                    </span>
                    <img
                      src={cat.image}
                      alt={cat.label}
                      class="absolute inset-0 w-full h-full object-cover"
                      loading="lazy"
                      decoding="async"
                      onerror="this.style.display='none'"
                    />
                  </div>
                  <div class="p-4 flex-1 flex flex-col">
                    <h3 class="font-display uppercase text-sm lg:text-base text-charcoal-800 group-hover:text-marine-700 transition-colors leading-tight">
                      {cat.label}
                    </h3>
                    <span class="inline-flex items-center gap-1 mt-3 text-xs lg:text-sm font-semibold text-marine-700 group-hover:text-sky-600">
                      Voir
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="card-chevron"><path d="m9 18 6-6-6-6"/></svg>
                    </span>
                  </div>
                </a>
              ))}
            </div>
          </div>
        );
      })}

      <div class="text-center mt-16 pt-12 border-t border-charcoal-100">
        <p class="text-charcoal-500 mb-5">9 familles supplémentaires : direction, habitacle, carrosserie, refroidissement, électricité…</p>
        <a href="/catalogue" class="btn-secondary btn-lg">Voir toutes les catégories</a>
      </div>
    </div>
  </section>

  {/* === 3.5) Marques constructeurs (shortcut grid) ========================
       Phase 5.1 D-2026-05-13d. Wordmark + logo grid des 16 constructeurs les
       plus représentés en France. Clic → /catalogue?marque=<id> qui est
       traité par le script inline de catalogue/index.astro (Phase 5.2). */}
  <section class="section-y bg-offwhite border-t border-charcoal-100">
    <div class="container-tight">
      <div class="mb-10 text-center max-w-2xl mx-auto">
        <span class="eyebrow" data-reveal>Par marque de véhicule</span>
        <h2 class="text-h2 lg:text-display-2 mt-2 mb-3" data-reveal data-reveal-delay="1">Quelle marque conduisez-vous ?</h2>
        <p class="text-charcoal-500 text-lg" data-reveal data-reveal-delay="2">
          Multi-marques sur toute la gamme constructeur — cliquez pour cibler votre catalogue.
        </p>
      </div>

      <ul class="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-6 lg:grid-cols-8 gap-3 lg:gap-4" data-reveal-group>
        {MARQUES_SHORTCUTS.map((m) => {
          const hasLogo = publicAssetExists(m.logo);
          return (
            <li data-reveal>
              <a
                href={`/catalogue?marque=${encodeURIComponent(m.id)}`}
                class="group relative aspect-[3/2] flex items-center justify-center bg-white rounded-card border border-charcoal-100 hover:border-marine-700 hover:shadow-card hover:-translate-y-0.5 transition-all duration-300 ease-brand p-3"
                title={`Catalogue pour ${m.name}`}
                aria-label={`Voir le catalogue pour ${m.name}`}
              >
                {hasLogo ? (
                  <img
                    src={m.logo}
                    alt={m.name}
                    class="max-h-full max-w-full object-contain transition-all duration-300"
                    loading="lazy"
                    decoding="async"
                  />
                ) : (
                  <span class="font-display uppercase text-charcoal-700 group-hover:text-marine-800 text-center text-xs sm:text-sm leading-tight px-2 transition-colors">
                    {m.name}
                  </span>
                )}
              </a>
            </li>
          );
        })}
      </ul>
      <p class="text-xs text-charcoal-400 mt-6 text-center">
        Votre marque n'est pas listée ? <a href="/contact#devis" class="link-inline text-xs">Demandez un devis</a> — nous couvrons l'ensemble du marché européen + japonais.
      </p>
    </div>
  </section>

  {/* === 4) Services ======================================================== */}
  <section class="section-y bg-marine-800 text-white relative overflow-hidden">
    <div class="container-tight relative">
      <div class="mb-10 max-w-2xl">
        <span class="eyebrow-light">Nos services</span>
        <h2 class="title-accent on-marine text-h2 lg:text-display-2 mt-2 mb-4">Du devis à la livraison.</h2>
        <p class="text-offwhite-200 text-lg">
          Particuliers, garages, ateliers, flottes. On s'adapte à votre besoin avec une équipe humaine et des équipementiers de référence.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5">
        {homeServices.map((s) => (
          <article class={`relative rounded-card p-6 backdrop-blur-sm border transition-all duration-300 ${
            s.usp
              ? 'bg-sky-400/10 border-sky-400/40 hover:bg-sky-400/15'
              : 'bg-marine-700/40 border-white/10 hover:bg-marine-700'
          }`}>
            {s.usp && <span class="badge-sky absolute top-4 right-4 !bg-sky-400/20 !text-sky-200 !border-sky-400/40">USP</span>}
            <h3 class="font-display uppercase text-lg text-white mb-2 pr-12">{s.label}</h3>
            <p class="text-sm text-offwhite-200 leading-relaxed mb-4">{s.short}</p>
            <a href={s.cta.href} class="inline-flex items-center gap-1 text-sm font-semibold text-sky-300 hover:text-sky-200">
              {s.cta.label}
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
            </a>
          </article>
        ))}
      </div>

      <div class="text-center mt-12">
        <a href="/services" class="btn-secondary-light btn-lg">Tous nos services</a>
      </div>
    </div>
  </section>

  {/* === 4.5) Comment ça marche (3 étapes Oscaro-style) ====================
       Refactor D-2026-05-13d (Phase 5.1) : remplace l'ancien "Why choose us"
       (3 raisons) par un parcours-pièce explicite — c'est ce que l'utilisateur
       qui découvre la marque cherche à comprendre avant de déclencher un devis. */}
  <section class="section-y bg-white">
    <div class="container-tight">
      <div class="mb-12 text-center max-w-2xl mx-auto">
        <span class="eyebrow" data-reveal>Comment ça marche</span>
        <h2 class="text-h2 lg:text-display-2 mt-2 mb-3" data-reveal data-reveal-delay="1">3 étapes, c'est tout.</h2>
      </div>

      <ol class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8" data-reveal-group>
        {howSteps.map((step) => (
          <li class="card p-6 lg:p-8 relative flex flex-col" data-reveal>
            <span class="absolute top-4 right-5 font-display text-7xl text-marine-100 leading-none select-none pointer-events-none" aria-hidden="true">{step.n}</span>
            <span class="inline-flex items-center justify-center size-10 rounded-pill bg-marine-800 text-white font-display text-lg mb-5 z-10 relative">
              {step.n}
            </span>
            <h3 class="font-display uppercase text-h3 text-charcoal-800 mb-3 leading-tight">{step.title}</h3>
            <p class="text-charcoal-600 leading-relaxed flex-1">{step.desc}</p>
            {step.cta && (
              <a href={step.cta.href} class="inline-flex items-center gap-1 mt-5 text-sm font-semibold text-marine-700 hover:text-sky-600">
                {step.cta.label}
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="card-chevron"><path d="m9 18 6-6-6-6"/></svg>
              </a>
            )}
          </li>
        ))}
      </ol>
    </div>
  </section>

  {/* === 4.6) Marques fournisseurs grid (D28, fair-use L713-6) ============== */}
  <section class="section-y bg-offwhite border-y border-charcoal-100">
    <div class="container-tight">
      <div class="mb-10 text-center max-w-2xl mx-auto">
        <span class="eyebrow">Nos équipementiers</span>
        <h2 class="text-h2 lg:text-display-2 mt-2 mb-4">{BRANDS.length} marques de référence.</h2>
        <p class="text-charcoal-500 text-lg">
          Des fournisseurs reconnus, choisis pour leur qualité et leur compatibilité multi-marques.
        </p>
      </div>

      {/*
        Rendu hybride : SVG officiel si présent dans /public/assets/brands/<id>.svg,
        sinon fallback typographique. Le check est fait au build time via
        publicAssetExists() — pas de 404 réseau si SVG manquant.
        Pour télécharger les logos officiels : `npm run assets:brand-logos`.
      */}
      <ul class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-8 gap-3 lg:gap-4" data-reveal-group>
        {BRANDS.map((b) => {
          const hasLogo = publicAssetExists(b.logo);
          return (
            <li class="group relative aspect-[3/2] flex items-center justify-center bg-white rounded-card border border-charcoal-100 hover:border-marine-700 hover:shadow-card hover:-translate-y-0.5 transition-all duration-300 ease-brand p-3"
                title={`${b.name} — ${b.tagline}`}
                data-reveal>
              {hasLogo ? (
                <img
                  src={b.logo}
                  alt={`Logo ${b.name}`}
                  class="max-h-full max-w-full object-contain transition-all duration-300"
                  loading="lazy"
                  decoding="async"
                />
              ) : (
                <span class="font-display uppercase text-charcoal-700 group-hover:text-marine-800 text-center text-xs sm:text-sm leading-tight px-2 transition-colors">
                  {b.name}
                </span>
              )}
            </li>
          );
        })}
      </ul>

    </div>
  </section>

  {showTiktoks && (
    <>
      {/* === 4.6bis) TikTok (J5 — self-host MP4 via yt-dlp) ================== */}
      <section class="section-y bg-offwhite-100">
        <div class="container-tight">
          <div class="flex flex-wrap items-end justify-between gap-4 mb-10">
            <div class="max-w-xl">
              <span class="eyebrow">Le magasin en vidéo</span>
              <h2 class="text-h2 lg:text-display-2 mt-2 mb-3">Nos coulisses sur TikTok.</h2>
              <p class="text-charcoal-500 text-lg">
                Démonstrations, conseils pratiques, coulisses du magasin — suivez notre quotidien à Colomiers.
              </p>
            </div>
            <a
              href={TIKTOK_PROFILE_URL}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-secondary btn-md whitespace-nowrap shrink-0"
            >
              Suivre @{TIKTOK_PROFILE_URL.split('@')[1]}
            </a>
          </div>

          <TikTokGrid
            client:visible
            tiktoks={availableTiktoks}
            profileUrl={TIKTOK_PROFILE_URL}
          />
        </div>
      </section>
    </>
  )}

  {/* === 4.7) Avis clients (AvisWidget + carousel conditionnelle) =========
       D-2026-05-13d (override F-2026-05-13d) : l'array `TESTIMONIALS` peut
       maintenant contenir 3-5 meilleurs avis Google copiés manuellement
       par l'owner (consent wall bloque tout scraping). Quand l'array est
       vide (`!showTestimonials`), la section se replie sur l'AvisWidget
       seul, comme dans le pivot 2026-05-13b. */}
  <section class="section-y bg-marine-800 text-white relative overflow-hidden">
    <div class="container-tight relative">
      <div class="text-center max-w-2xl mx-auto mb-10">
        <span class="eyebrow-light" data-reveal>Avis clients</span>
        <h2 class="title-accent on-marine text-h2 lg:text-display-2 mt-2 mb-4" data-reveal data-reveal-delay="1">Ce qu'ils en disent.</h2>
        <p class="text-offwhite-200 text-lg" data-reveal data-reveal-delay="2">
          {showTestimonials
            ? "Quelques retours de clients passés par le magasin. L'intégralité des avis reste consultable sur Google."
            : "Tous nos avis sont sur Google — pas de copie locale, pas de mise en scène. Vous lisez directement les commentaires des clients qui sont passés par le magasin."}
        </p>
      </div>

      {showTestimonials && (
        <ul class="grid grid-cols-1 md:grid-cols-3 gap-5 lg:gap-6 mb-10 max-w-5xl mx-auto" data-reveal-group>
          {topTestimonials.map((t) => (
            <li class="bg-marine-700/40 backdrop-blur-sm border border-white/10 rounded-card p-5 lg:p-6 flex flex-col text-left" data-reveal>
              <div class="flex items-center gap-1 text-amber-300 mb-3" aria-label={`${t.rating} étoiles sur 5`}>
                {Array.from({ length: t.rating }).map(() => (
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                ))}
              </div>
              <blockquote class="text-sm lg:text-base text-offwhite-100 leading-relaxed flex-1 mb-4 italic">« {t.text} »</blockquote>
              <div class="flex items-center justify-between text-xs text-offwhite-200/80">
                <span class="font-semibold text-white">{t.author}</span>
                <time datetime={t.date}>{new Date(t.date).toLocaleDateString('fr-FR', { year: 'numeric', month: 'long' })}</time>
              </div>
              {(t.vehicle || t.part) && (
                <div class="mt-3 pt-3 border-t border-white/10 text-xs text-offwhite-200/70">
                  {t.vehicle && <span>{t.vehicle}</span>}
                  {t.vehicle && t.part && <span class="mx-1.5">·</span>}
                  {t.part && <span>{t.part}</span>}
                </div>
              )}
            </li>
          ))}
        </ul>
      )}

      <div class="text-center" data-reveal data-reveal-delay="3">
        <AvisWidget variant="dark" />
      </div>
        <div class="mt-8" data-reveal data-reveal-delay="4">
          <a
            href={STORE.avis.googleBusinessUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-md bg-white text-marine-900 shadow-card hover:bg-offwhite-100 hover:-translate-y-0.5 hover:shadow-card-hover inline-flex items-center gap-2"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg>
            Lire et laisser un avis
          </a>
        </div>
      </div>
    </div>
  </section>

  {/* === 5) FAQ ============================================================= */}
  <section class="section-y bg-white">
    <div class="container-narrow">
      <div class="mb-10 text-center">
        <span class="eyebrow">Questions fréquentes</span>
        <h2 class="text-h2 lg:text-display-2 mt-2">Tout ce que vous voulez savoir.</h2>
      </div>

      <div class="space-y-3">
        {homeFaq.map((f) => (
          <details class="card group p-0 overflow-hidden">
            <summary class="cursor-pointer p-5 flex items-start justify-between gap-4 hover:bg-charcoal-50 transition-colors list-none">
              <h3 class="font-display uppercase text-base text-charcoal-800 group-open:text-marine-700">{f.q}</h3>
              <svg class="shrink-0 mt-1 transition-transform group-open:rotate-180 text-charcoal-400 group-open:text-marine-700" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
            </summary>
            <div class="px-5 pb-5 text-charcoal-600 leading-relaxed">
              {f.a}
            </div>
          </details>
        ))}
      </div>

      <div class="text-center mt-10">
        <a href="/contact" class="link-inline">Une autre question ? Contactez-nous</a>
      </div>
    </div>
  </section>

  {/* === 6) CTA final (ADR-001 — marine bg + white pill, plus de fond jaune) = */}
  <section class="bg-marine-800 text-white relative overflow-hidden">
    <div class="container-tight section-y relative text-center max-w-3xl">
      <h2 class="text-h2 lg:text-display-2">Une pièce en tête ?</h2>
      <p class="text-lg text-offwhite-200 mt-4 mb-8 leading-relaxed">
        Marque, modèle, année, code moteur ou référence OEM — partagez ce que vous savez. On revient sous 24 h.
      </p>
      <div class="flex flex-wrap justify-center items-center gap-3">
        <a href="/contact#devis" class="btn-md bg-white text-marine-900 shadow-card hover:bg-offwhite-100 hover:-translate-y-0.5 hover:shadow-card-hover">
          Demander un devis
        </a>
        <a href={telUrl()} class="btn-md border-2 border-white/40 text-white hover:bg-white/10">
          {STORE.contact.telDisplay}
        </a>
      </div>
    </div>
  </section>
  {/* Wires every [data-vehicle-open] button to the VehiclePanel modal open event.
     The panel itself lives in Header.astro (client:load), so by the time any
     click fires the listener is registered. Cf. src/lib/my-vehicle.ts. */}
  <script is:inline>
    (function () {
      document.querySelectorAll('[data-vehicle-open]').forEach(function (el) {
        el.addEventListener('click', function () {
          window.dispatchEvent(new CustomEvent('pac:vehicle-open'));
        });
      });
    })();
  </script>
</Layout>
