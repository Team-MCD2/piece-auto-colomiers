---
/**
 * Services — page complète détaillant les 6 services V1.
 *
 * Cf. plan.md §7 et `src/data/services.js`.
 */

import Layout from '../layouts/Layout.astro';
import LucideIcon from '../components/LucideIcon.astro';
import { SERVICES } from '../data/services.js';
import { FAQ } from '../data/faq.js';
import { GENERAL_FAQS } from '../data/category-faqs.js';
import { STORE, telUrl, whatsappUrl } from '../data/store.js';
import WhatsAppIcon from '../components/WhatsAppIcon.astro';

const breadcrumb = [
  { label: 'Accueil', href: '/' },
  { label: 'Services' },
];

// Pré-tri pour mettre les USP en premier (visuel impactant en haut de page)
const sortedServices = [...SERVICES].sort((a, b) => Number(b.usp) - Number(a.usp));
---

<Layout
  title="Nos services — Pièces Auto Colomiers"
  description="Devis sous 24 h, expédition Mondial Relay, retrait magasin, conseil pro, commande sur référence OEM, tarif revendeur pour les professionnels."
  breadcrumb={breadcrumb}
  faq={FAQ.map((f) => ({ q: f.q, a: f.a }))}
>
  {/* Hero */}
  <section class="bg-gradient-hero text-white relative overflow-hidden">
    <div class="absolute inset-0 bg-hex-pattern opacity-30" aria-hidden="true"></div>
    <div class="container-tight section-y relative">
      <nav aria-label="Fil d'Ariane" class="text-sm text-offwhite-200 mb-4">
        <a href="/" class="hover:text-sky-300">Accueil</a>
        <span class="mx-2 opacity-50">›</span>
        <span>Services</span>
      </nav>
      <span class="eyebrow-light" data-reveal>Tout ce qu'on fait</span>
      <h1
        class="title-accent on-marine text-h1 lg:text-display-2 mt-2 mb-4"
        data-reveal
        data-reveal-delay="1"
        style="view-transition-name: hero-title;"
      >Du devis à la livraison.</h1>
      <p class="text-lg text-offwhite-200 max-w-prose" data-reveal data-reveal-delay="2">
        Particuliers, garages, ateliers, flottes. Notre métier : trouver la pièce qu'il vous faut, vous conseiller,
        et vous la livrer comme vous voulez — magasin, point relais, sur place.
      </p>
    </div>
  </section>

  {/* Liste services — USP en premier (sortedServices) */}
  <section class="section-y bg-offwhite">
    <div class="container-tight space-y-5 lg:space-y-6" data-reveal-group>
      {sortedServices.map((s) => (
        <article
          data-reveal
          id={s.slug}
          class:list={[
            'card group p-6 lg:p-8 transition-all duration-300 ease-brand',
            s.usp
              ? 'border-2 border-sky-400/40 shadow-card hover:shadow-card-hover hover:-translate-y-1 bg-gradient-to-br from-white to-sky-50/40'
              : 'hover:border-marine-700/30 hover:shadow-card',
          ]}
        >
          <div class="flex flex-col lg:flex-row gap-5 lg:gap-7 items-start">
            {/* Icon avatar — gros, coloré selon contexte (USP/B2B/standard) */}
            <div
              class:list={[
                'inline-flex size-14 lg:size-16 shrink-0 items-center justify-center rounded-card transition-transform group-hover:scale-110 group-hover:rotate-[-4deg]',
                s.usp
                  ? 'bg-marine-800 text-white shadow-card'
                  : s.audience === 'pro'
                  ? 'bg-sky-400/20 text-sky-700 border border-sky-400/40'
                  : 'bg-marine-800 text-sky-300',
              ]}
              aria-hidden="true"
            >
              <LucideIcon name={s.icon} size={28} strokeWidth={2.2} />
            </div>

            {/* Content — titre + badges + short + desc */}
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-2 mb-2 flex-wrap">
                {s.usp && <span class="badge-sky">Phare</span>}
                {s.audience === 'pro' && <span class="badge-sky">B2B</span>}
                {s.badge && <span class="badge-soft">{s.badge}</span>}
              </div>
              <h2 class="font-display uppercase text-h3 text-marine-800 leading-tight">{s.label}</h2>
              <p class="text-sm text-charcoal-500 mt-1.5 mb-3 italic">{s.short}</p>
              <p class="text-charcoal-700 leading-relaxed">{s.desc}</p>
            </div>

            {/* CTA — full-width mobile, auto-width desktop, jamais brisé */}
            <div class="lg:shrink-0 lg:ml-2 w-full lg:w-auto">
              <a
                href={s.cta.href}
                class:list={[
                  s.usp ? 'btn-primary' : 'btn-secondary',
                  'btn-md w-full lg:w-auto whitespace-nowrap',
                ]}
              >
                {s.cta.label}
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  {/* FAQ inline — service-specific */}
  <section class="section-y bg-white">
    <div class="container-narrow">
      <div class="mb-8 text-center">
        <span class="eyebrow">Questions fréquentes</span>
        <h2 class="text-h2 lg:text-display-2 mt-2">Vos questions sur nos services.</h2>
      </div>
      <div class="space-y-3">
        {GENERAL_FAQS.services.map((f) => (
          <details class="card group p-0 overflow-hidden">
            <summary class="cursor-pointer p-5 flex items-start justify-between gap-4 hover:bg-charcoal-50 transition-colors list-none">
              <h3 class="font-display uppercase text-base text-charcoal-800 group-open:text-marine-700">{f.q}</h3>
              <svg class="shrink-0 mt-1 transition-transform group-open:rotate-180 text-charcoal-400 group-open:text-marine-700" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
            </summary>
            <div class="px-5 pb-5 text-charcoal-600 leading-relaxed">{f.a}</div>
          </details>
        ))}
      </div>
    </div>
  </section>

  {/* CTA diagnostic final */}
  <section class="bg-marine-800 text-white relative overflow-hidden">
    <div class="absolute inset-0 bg-hex-pattern opacity-20" aria-hidden="true"></div>
    <div class="container-tight section-y relative text-center max-w-3xl">
      <h2 class="text-h2 lg:text-display-2">Besoin d'un devis rapide ?</h2>
      <p class="text-lg text-offwhite-200 mt-4 mb-8 leading-relaxed">
        Marque, modèle, année, référence OEM — partagez ce que vous savez. On revient sous 24 h.
      </p>
      <div class="flex flex-wrap justify-center items-center gap-3">
        <a href="/contact#devis" class="btn-md bg-white text-marine-900 shadow-card hover:bg-offwhite-100 hover:-translate-y-0.5 hover:shadow-card-hover">
          Demander un devis
        </a>
        <a href={whatsappUrl()} target="_blank" rel="noopener" class="btn-whatsapp btn-md">
          <WhatsAppIcon size={18} />
          WhatsApp
        </a>
        <a href={telUrl()} class="btn-md border-2 border-white/40 text-white hover:bg-white/10">
          {STORE.contact.telDisplay}
        </a>
      </div>
    </div>
  </section>
</Layout>
